from Phidget22.ErrorCode import ErrorCode
from typing import Callable, Optional
from typing import Sequence
from Phidget22.LEDArrayColor import LEDArrayColor
from Phidget22.LEDArrayAnimation import LEDArrayAnimation
from Phidget22.LEDArrayAnimationType import LEDArrayAnimationType
from Phidget22.LEDArrayColorOrder import LEDArrayColorOrder
from Phidget22.PhidgetException import PhidgetException
from Phidget22.Phidget import Phidget


class LEDArray(Phidget):
    def __init__(self) -> None: ...
    def __del__(self) -> None: ...
    def getMinAddress(self) -> int: ...
    def getMaxAddress(self) -> int: ...
    def setAnimation(
        self, animationID: int, pattern: Sequence[LEDArrayColor], animation: LEDArrayAnimation
    ) -> None: ...
    def getMinAnimationID(self) -> int: ...
    def getMaxAnimationID(self) -> int: ...
    def getMinAnimationPatternCount(self) -> int: ...
    def getMaxAnimationPatternCount(self) -> int: ...
    def getBrightness(self) -> float: ...
    def setBrightness(self, Brightness: float) -> None: ...
    def getMinBrightness(self) -> float: ...
    def getMaxBrightness(self) -> float: ...
    def clearLEDs(self) -> None: ...
    def getColorOrder(self) -> LEDArrayColorOrder: ...
    def setColorOrder(self, ColorOrder: LEDArrayColorOrder) -> None: ...
    def getMinFadeTime(self) -> int: ...
    def getMaxFadeTime(self) -> int: ...
    def getGamma(self) -> float: ...
    def setGamma(self, Gamma: float) -> None: ...
    def getMinGamma(self) -> float: ...
    def getMaxGamma(self) -> float: ...
    def setLED(self, address: int, color: LEDArrayColor, fadeTime: int) -> None: ...
    def getMinLEDCount(self) -> int: ...
    def getMaxLEDCount(self) -> int: ...
    def setLEDs(
        self, startAddress: int, endAddress: int, leds: Sequence[LEDArrayColor], fadeTime: int
    ) -> None: ...
    def setLEDs_async(
        self,
        startAddress: int,
        endAddress: int,
        leds: Sequence[LEDArrayColor],
        fadeTime: int,
        asyncHandler: Optional[Callable[[LEDArray, ErrorCode, str], None]],
    ) -> None: ...
    async def setLEDsAsync(
        self, startAddress: int, endAddress: int, leds: Sequence[LEDArrayColor], fadeTime: int
    ) -> None: ...
    def getPowerEnabled(self) -> bool: ...
    def setPowerEnabled(self, PowerEnabled: bool) -> None: ...
    def stopAnimation(self, animationID: int) -> None: ...
    def synchronizeAnimations(self) -> None: ...


__all__ = [
    "ErrorCode",
    "LEDArray",
    "LEDArrayColor",
    "LEDArrayAnimation",
    "LEDArrayAnimationType",
    "LEDArrayColorOrder",
    "PhidgetException",
    "Phidget",
]
