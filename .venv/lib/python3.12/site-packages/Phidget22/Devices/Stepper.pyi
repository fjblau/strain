from Phidget22.ErrorCode import ErrorCode
from typing import Callable, Optional
from typing import Sequence
from Phidget22.StepperControlMode import StepperControlMode
from Phidget22.PhidgetException import PhidgetException
from Phidget22.Phidget import Phidget


class Stepper(Phidget):
    def __init__(self) -> None: ...
    def __del__(self) -> None: ...
    def setOnPositionChangeHandler(
        self, handler: Optional[Callable[[Stepper, float], None]]
    ) -> None: ...
    def setOnStoppedHandler(self, handler: Optional[Callable[[Stepper], None]]) -> None: ...
    def setOnVelocityChangeHandler(
        self, handler: Optional[Callable[[Stepper, float], None]]
    ) -> None: ...
    def getAcceleration(self) -> float: ...
    def setAcceleration(self, Acceleration: float) -> None: ...
    def getMinAcceleration(self) -> float: ...
    def getMaxAcceleration(self) -> float: ...
    def getControlMode(self) -> StepperControlMode: ...
    def setControlMode(self, ControlMode: StepperControlMode) -> None: ...
    def getCurrentLimit(self) -> float: ...
    def setCurrentLimit(self, CurrentLimit: float) -> None: ...
    def getMinCurrentLimit(self) -> float: ...
    def getMaxCurrentLimit(self) -> float: ...
    def getDataInterval(self) -> int: ...
    def setDataInterval(self, DataInterval: int) -> None: ...
    def getMinDataInterval(self) -> int: ...
    def getMaxDataInterval(self) -> int: ...
    def getDataRate(self) -> float: ...
    def setDataRate(self, DataRate: float) -> None: ...
    def getMinDataRate(self) -> float: ...
    def getMaxDataRate(self) -> float: ...
    def getEngaged(self) -> bool: ...
    def setEngaged(self, Engaged: bool) -> None: ...
    def enableFailsafe(self, failsafeTime: int) -> None: ...
    def getMinFailsafeTime(self) -> int: ...
    def getMaxFailsafeTime(self) -> int: ...
    def getHoldingCurrentLimit(self) -> float: ...
    def setHoldingCurrentLimit(self, HoldingCurrentLimit: float) -> None: ...
    def getIsMoving(self) -> bool: ...
    def getPosition(self) -> float: ...
    def getMinPosition(self) -> float: ...
    def getMaxPosition(self) -> float: ...
    def addPositionOffset(self, positionOffset: float) -> None: ...
    def getRescaleFactor(self) -> float: ...
    def setRescaleFactor(self, RescaleFactor: float) -> None: ...
    def resetFailsafe(self) -> None: ...
    def getTargetPosition(self) -> float: ...
    def setTargetPosition(self, TargetPosition: float) -> None: ...
    def setTargetPosition_async(
        self,
        TargetPosition: float,
        asyncHandler: Optional[Callable[[Stepper, ErrorCode, str], None]],
    ) -> None: ...
    async def setTargetPositionAsync(self, TargetPosition: float) -> None: ...
    def getVelocity(self) -> float: ...
    def getVelocityLimit(self) -> float: ...
    def setVelocityLimit(self, VelocityLimit: float) -> None: ...
    def getMinVelocityLimit(self) -> float: ...
    def getMaxVelocityLimit(self) -> float: ...


__all__ = ["ErrorCode", "Stepper", "StepperControlMode", "PhidgetException", "Phidget"]
