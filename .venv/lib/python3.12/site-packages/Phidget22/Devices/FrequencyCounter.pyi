from typing import Callable, Optional
from typing import Sequence
from Phidget22.FilterType import FilterType
from Phidget22.InputMode import InputMode
from Phidget22.PowerSupply import PowerSupply
from Phidget22.PhidgetException import PhidgetException
from Phidget22.Phidget import Phidget


class FrequencyCounter(Phidget):
    def __init__(self) -> None: ...
    def __del__(self) -> None: ...
    def setOnCountChangeHandler(
        self, handler: Optional[Callable[[FrequencyCounter, int, float], None]]
    ) -> None: ...
    def setOnFrequencyChangeHandler(
        self, handler: Optional[Callable[[FrequencyCounter, float], None]]
    ) -> None: ...
    def getCount(self) -> int: ...
    def getDataInterval(self) -> int: ...
    def setDataInterval(self, DataInterval: int) -> None: ...
    def getMinDataInterval(self) -> int: ...
    def getMaxDataInterval(self) -> int: ...
    def getDataRate(self) -> float: ...
    def setDataRate(self, DataRate: float) -> None: ...
    def getMinDataRate(self) -> float: ...
    def getMaxDataRate(self) -> float: ...
    def getEnabled(self) -> bool: ...
    def setEnabled(self, Enabled: bool) -> None: ...
    def getFilterType(self) -> FilterType: ...
    def setFilterType(self, FilterType: FilterType) -> None: ...
    def getFrequency(self) -> float: ...
    def getMaxFrequency(self) -> float: ...
    def getFrequencyCutoff(self) -> float: ...
    def setFrequencyCutoff(self, FrequencyCutoff: float) -> None: ...
    def getMinFrequencyCutoff(self) -> float: ...
    def getMaxFrequencyCutoff(self) -> float: ...
    def getInputMode(self) -> InputMode: ...
    def setInputMode(self, InputMode: InputMode) -> None: ...
    def getPowerSupply(self) -> PowerSupply: ...
    def setPowerSupply(self, PowerSupply: PowerSupply) -> None: ...
    def reset(self) -> None: ...
    def getTimeElapsed(self) -> float: ...


__all__ = [
    "FrequencyCounter",
    "FilterType",
    "InputMode",
    "PowerSupply",
    "PhidgetException",
    "Phidget",
]
