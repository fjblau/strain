from typing import Callable, Optional
from typing import Sequence
from Phidget22.PhidgetException import PhidgetException
from Phidget22.Phidget import Phidget


class Magnetometer(Phidget):
    def __init__(self) -> None: ...
    def __del__(self) -> None: ...
    def setOnMagneticFieldChangeHandler(
        self, handler: Optional[Callable[[Magnetometer, list[float], float], None]]
    ) -> None: ...
    def getAxisCount(self) -> int: ...
    def setCorrectionParameters(
        self,
        magneticField: float,
        offset0: float,
        offset1: float,
        offset2: float,
        gain0: float,
        gain1: float,
        gain2: float,
        T0: float,
        T1: float,
        T2: float,
        T3: float,
        T4: float,
        T5: float,
    ) -> None: ...
    def getDataInterval(self) -> int: ...
    def setDataInterval(self, DataInterval: int) -> None: ...
    def getMinDataInterval(self) -> int: ...
    def getMaxDataInterval(self) -> int: ...
    def getDataRate(self) -> float: ...
    def setDataRate(self, DataRate: float) -> None: ...
    def getMinDataRate(self) -> float: ...
    def getMaxDataRate(self) -> float: ...
    def getHeatingEnabled(self) -> bool: ...
    def setHeatingEnabled(self, HeatingEnabled: bool) -> None: ...
    def getMagneticField(self) -> list[float]: ...
    def getMinMagneticField(self) -> list[float]: ...
    def getMaxMagneticField(self) -> list[float]: ...
    def getMagneticFieldChangeTrigger(self) -> float: ...
    def setMagneticFieldChangeTrigger(self, MagneticFieldChangeTrigger: float) -> None: ...
    def getMinMagneticFieldChangeTrigger(self) -> float: ...
    def getMaxMagneticFieldChangeTrigger(self) -> float: ...
    def resetCorrectionParameters(self) -> None: ...
    def saveCorrectionParameters(self) -> None: ...
    def getTimestamp(self) -> float: ...


__all__ = ["Magnetometer", "PhidgetException", "Phidget"]
