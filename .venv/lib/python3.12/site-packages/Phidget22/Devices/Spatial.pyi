from typing import Callable, Optional
from typing import Sequence
from Phidget22.SpatialPrecision import SpatialPrecision
from Phidget22.SpatialAlgorithm import SpatialAlgorithm
from Phidget22.SpatialEulerAngles import SpatialEulerAngles
from Phidget22.SpatialQuaternion import SpatialQuaternion
from Phidget22.PhidgetException import PhidgetException
from Phidget22.Phidget import Phidget


class Spatial(Phidget):
    def __init__(self) -> None: ...
    def __del__(self) -> None: ...
    def setOnAlgorithmDataHandler(
        self, handler: Optional[Callable[[Spatial, list[float], float], None]]
    ) -> None: ...
    def setOnSpatialDataHandler(
        self,
        handler: Optional[Callable[[Spatial, list[float], list[float], list[float], float], None]],
    ) -> None: ...
    def _getPrecision(self) -> SpatialPrecision: ...
    def _setPrecision(self, Precision: SpatialPrecision) -> None: ...
    def getMinAcceleration(self) -> list[float]: ...
    def getMaxAcceleration(self) -> list[float]: ...
    def setAHRSParameters(
        self,
        angularVelocityThreshold: float,
        angularVelocityDeltaThreshold: float,
        accelerationThreshold: float,
        magTime: float,
        accelTime: float,
        biasTime: float,
    ) -> None: ...
    def getAlgorithm(self) -> SpatialAlgorithm: ...
    def setAlgorithm(self, Algorithm: SpatialAlgorithm) -> None: ...
    def getAlgorithmMagnetometerGain(self) -> float: ...
    def setAlgorithmMagnetometerGain(self, AlgorithmMagnetometerGain: float) -> None: ...
    def getMinAngularRate(self) -> list[float]: ...
    def getMaxAngularRate(self) -> list[float]: ...
    def getDataInterval(self) -> int: ...
    def setDataInterval(self, DataInterval: int) -> None: ...
    def getMinDataInterval(self) -> int: ...
    def getMaxDataInterval(self) -> int: ...
    def getDataRate(self) -> float: ...
    def setDataRate(self, DataRate: float) -> None: ...
    def getMinDataRate(self) -> float: ...
    def getMaxDataRate(self) -> float: ...
    def getEulerAngles(self) -> SpatialEulerAngles: ...
    def getHeatingEnabled(self) -> bool: ...
    def setHeatingEnabled(self, HeatingEnabled: bool) -> None: ...
    def getMinMagneticField(self) -> list[float]: ...
    def getMaxMagneticField(self) -> list[float]: ...
    def setMagnetometerCorrectionParameters(
        self,
        magneticField: float,
        offset0: float,
        offset1: float,
        offset2: float,
        gain0: float,
        gain1: float,
        gain2: float,
        T0: float,
        T1: float,
        T2: float,
        T3: float,
        T4: float,
        T5: float,
    ) -> None: ...
    def getQuaternion(self) -> SpatialQuaternion: ...
    def resetMagnetometerCorrectionParameters(self) -> None: ...
    def saveMagnetometerCorrectionParameters(self) -> None: ...
    def zeroAlgorithm(self) -> None: ...
    def zeroGyro(self) -> None: ...


__all__ = [
    "Spatial",
    "SpatialPrecision",
    "SpatialAlgorithm",
    "SpatialEulerAngles",
    "SpatialQuaternion",
    "PhidgetException",
    "Phidget",
]
