from typing import Final
from typing import Callable, Optional
from typing import Sequence
from Phidget22.ChannelClass import ChannelClass
from Phidget22.ChannelSubclass import ChannelSubclass
from Phidget22.DeviceClass import DeviceClass
from Phidget22.DeviceID import DeviceID
from Phidget22.ErrorEventCode import ErrorEventCode
from Phidget22.PhidgetException import PhidgetException


class Phidget:
    def __init__(self) -> None: ...
    @classmethod
    def _from_handle(cls, handle: int) -> Phidget: ...
    def __del__(self) -> None: ...
    def setOnAttachHandler(self, handler: Optional[Callable[[Phidget], None]]) -> None: ...
    def setOnDetachHandler(self, handler: Optional[Callable[[Phidget], None]]) -> None: ...
    def setOnErrorHandler(
        self, handler: Optional[Callable[[Phidget, ErrorEventCode, str], None]]
    ) -> None: ...
    def setOnPropertyChangeHandler(
        self, handler: Optional[Callable[[Phidget, str], None]]
    ) -> None: ...
    @staticmethod
    def finalize(flags: int) -> None: ...
    @staticmethod
    def getLibraryVersion() -> str: ...
    @staticmethod
    def getLibraryVersionNumber() -> str: ...
    @staticmethod
    def resetLibrary() -> None: ...
    def _getClientVersion(self) -> tuple[int, int]: ...
    def _getDeviceFirmwareUpgradeString(self) -> str: ...
    def _getDeviceSKU_Revision(self) -> str: ...
    def _getDeviceVINTID(self) -> int: ...
    def _getServerVersion(self) -> tuple[int, int]: ...
    def _reboot(self) -> None: ...
    def _rebootFirmwareUpgrade(self, upgradeTimeout: int) -> None: ...
    def getAttached(self) -> bool: ...
    def getChannel(self) -> int: ...
    def setChannel(self, Channel: int) -> None: ...
    def getChannelClass(self) -> ChannelClass: ...
    def getChannelClassName(self) -> str: ...
    def getChannelName(self) -> str: ...
    def getChannelPersistence(self) -> bool: ...
    def setChannelPersistence(self, ChannelPersistence: bool) -> None: ...
    def getChannelSubclass(self) -> ChannelSubclass: ...
    def close(self) -> None: ...
    def getDeviceChannelCount(self, cls: ChannelClass) -> int: ...
    def getDeviceClass(self) -> DeviceClass: ...
    def getDeviceClassName(self) -> str: ...
    def getDeviceID(self) -> DeviceID: ...
    def getDeviceLabel(self) -> str: ...
    def setDeviceLabel(self, DeviceLabel: str) -> None: ...
    def getDeviceName(self) -> str: ...
    def getDeviceSerialNumber(self) -> int: ...
    def setDeviceSerialNumber(self, DeviceSerialNumber: int) -> None: ...
    def getDeviceSKU(self) -> str: ...
    def getDeviceVersion(self) -> int: ...
    def getHub(self) -> Phidget: ...
    def getHubPort(self) -> int: ...
    def setHubPort(self, HubPort: int) -> None: ...
    def getHubPortCount(self) -> int: ...
    def getHubPortSpeed(self) -> int: ...
    def setHubPortSpeed(self, HubPortSpeed: int) -> None: ...
    def getMaxHubPortSpeed(self) -> int: ...
    def getHubPortSupportsAutoSetSpeed(self) -> bool: ...
    def getHubPortSupportsSetSpeed(self) -> bool: ...
    def getIsChannel(self) -> bool: ...
    def getIsHubPortDevice(self) -> bool: ...
    def setIsHubPortDevice(self, IsHubPortDevice: bool) -> None: ...
    def getIsLocal(self) -> bool: ...
    def setIsLocal(self, IsLocal: bool) -> None: ...
    def getIsOpen(self) -> bool: ...
    def getIsRemote(self) -> bool: ...
    def setIsRemote(self, IsRemote: bool) -> None: ...
    def open(self) -> None: ...
    def openWaitForAttachment(self, timeout: int) -> None: ...
    def getParent(self) -> Phidget | None: ...
    def getServerHostname(self) -> str: ...
    def getServerName(self) -> str: ...
    def setServerName(self, ServerName: str) -> None: ...
    def getServerPeerName(self) -> str: ...
    def getServerUniqueName(self) -> str: ...
    def getMaxVINTDeviceSpeed(self) -> int: ...
    def getVINTDeviceSupportsAutoSetSpeed(self) -> bool: ...
    def getVINTDeviceSupportsSetSpeed(self) -> bool: ...
    def writeDeviceLabel(self, deviceLabel: str) -> None: ...

    ANY_SERIAL_NUMBER: Final[int] = -1
    ANY_HUB_PORT: Final[int] = -1
    ANY_CHANNEL: Final[int] = -1
    ANY_LABEL: Final = None
    INFINITE_TIMEOUT: Final[int] = 0
    DEFAULT_TIMEOUT: Final[int] = 1000
    AUTO_HUBPORTSPEED: Final[int] = 0


__all__ = [
    "Phidget",
    "ChannelClass",
    "ChannelSubclass",
    "DeviceClass",
    "DeviceID",
    "ErrorEventCode",
    "PhidgetException",
]
